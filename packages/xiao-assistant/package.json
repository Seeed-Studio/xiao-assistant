{
  "name": "@seeed-studio/xiao-assistant",
  "version": "0.2.0",
  "description": "MCP server + CLI for Seeed Studio XIAO boards: verified pinouts for 17 boards (ESP32-C5, nRF54LM20A...), 64 compile-checked examples, fuzzy + Chinese search, flashing troubleshooting. Works with Claude, Cursor, or standalone.",
  "type": "module",
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./cli": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xiao": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && rm -rf dist/data dist/web && cp -r data dist/data && cp -r web dist/web",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "clean": "rm -rf dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:wiki": "node scripts/sync-wiki.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "figlet": "^1.11.4",
    "minisearch": "^7.2.0",
    "open": "^10.2.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seeedstudio/xiao-assistant.git"
  },
  "keywords": [
    "xiao",
    "seeed",
    "seeed-studio",
    "seeed-xiao",
    "esp32",
    "esp32s3",
    "esp32c3",
    "esp32c6",
    "esp32c5",
    "rp2040",
    "rp2350",
    "nrf52840",
    "nrf54l15",
    "nrf54lm20a",
    "samd21",
    "ra4m1",
    "mg24",
    "pinout",
    "pinout-diagram",
    "mcp",
    "mcp-server",
    "arduino",
    "micropython",
    "circuitpython",
    "zephyr",
    "embedded",
    "electronics",
    "iot",
    "bluetooth",
    "wifi",
    "developer-tools",
    "ai-assistant"
  ],
  "author": "Seeed Studio",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
