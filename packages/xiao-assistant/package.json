{
  "name": "@seeed-studio/xiao-assistant",
  "version": "0.0.3",
  "description": "XIAO Assistant - AI-powered development tools for Seeed Studio XIAO series",
  "type": "module",
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./cli": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xiao": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && rm -rf dist/data dist/web && cp -r data dist/data && cp -r web dist/web",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "clean": "rm -rf dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "figlet": "^1.9.4",
    "open": "^10.1.0",
    "ora": "^9.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seeedstudio/xiao-assistant.git"
  },
  "keywords": [
    "xiao",
    "seeed-studio",
    "iot",
    "arduino",
    "micropython",
    "circuitpython",
    "mcp",
    "development-tools"
  ],
  "author": "Seeed Studio",
  "license": "MIT"
}
